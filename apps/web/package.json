{
  "name": "@safesight/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-3000}",
    "build": "NEXT_OUTPUT_DIR=.next-production next build",
    "start": "NEXT_OUTPUT_DIR=.next-production next start --hostname ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-3000}",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@safesight/contracts": "workspace:*",
    "@tanstack/react-query": "5.90.10",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.1.17"
  }
}
