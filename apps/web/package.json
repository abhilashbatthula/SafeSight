{
  "name": "@safesight/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-3000}",
    "build": "NEXT_OUTPUT_DIR=.next-production next build",
    "start": "NEXT_OUTPUT_DIR=.next-production next start --hostname ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-3000}",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@safesight/contracts": "workspace:*",
    "@tanstack/react-query": "5.90.10",
    "react-hook-form": "7.66.1",
    "@hookform/resolvers": "5.2.2",
    "zod": "4.1.12",
    "recharts": "3.4.1",
    "lucide-react": "0.553.0",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.1.17",
    "@tailwindcss/postcss": "4.1.17"
  }
}
